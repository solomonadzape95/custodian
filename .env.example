# --- DataHub ---------------------------------------------------------------
# GMS endpoint from `datahub docker quickstart` (UI lives on :9002)
DATAHUB_GMS_URL=http://localhost:8080
# Personal Access Token: DataHub UI -> Settings -> Access Tokens
DATAHUB_GMS_TOKEN=

# --- MCP server ------------------------------------------------------------
# REQUIRED. Without this the mutation tools are never registered and every
# write silently no-ops. Startup log must read "Mutation Tools ENABLED".
TOOLS_IS_MUTATION_ENABLED=true

# --- LLM provider ----------------------------------------------------------
CUSTODIAN_PROVIDER=gemini
# Free tier key from https://aistudio.google.com/apikey
# Keep this on a project with billing DISABLED — enabling billing deletes the
# free tier for that project and every call becomes billable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Max tool round-trips per agent run. google-genai defaults to 10, which
# silently truncates multi-hop lineage walks mid-investigation.
CUSTODIAN_MAX_TOOL_CALLS=40
